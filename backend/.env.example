# ── Core (Phase 1) ────────────────────────────────────────────────
APP_ENV=development
APP_SECRET_KEY=                      # session signing
CREDENTIAL_ENCRYPTION_KEY=           # AES-GCM/Fernet key for platform secrets
LOG_LEVEL=INFO

# ── MySQL (Phase 1) ───────────────────────────────────────────────
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_DATABASE=architectos
MYSQL_USER=architectos
MYSQL_PASSWORD=

# ── Redis (Phase 1) ───────────────────────────────────────────────
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0
JOB_QUEUE_KEY=architectos:jobs

# ── Seeded user (Phase 1) ─────────────────────────────────────────
SEED_USER_EMAIL=
SEED_USER_PASSWORD=                  # hashed on first boot; never logged

# ── Frontend (Phase 1) ────────────────────────────────────────────
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000/api/v1
FRONTEND_ORIGIN=http://localhost:2004

# ── LLM (declared Phase 1, used from Phase 2) ─────────────────────
# Primary provider is FreeLLMAPI (self-hosted, OpenAI-compatible). Fallback: groq.
# FREELLM_BASE_URL may be given with or without the trailing /v1 (added if missing).
FREELLM_BASE_URL=http://localhost:3333/v1
FREELLM_API_KEY=
FREELLM_MODEL=auto                   # one model id for both tiers

GROQ_API_KEY=
GROQ_MODEL_STRONG=                   # resolve against live catalog — Q1
GROQ_MODEL_SMALL=
LLM_REQUEST_TIMEOUT_SECONDS=60
LLM_MAX_RETRIES=2
LLM_MAX_TOKENS=4096
LLM_PLANNER_MAX_TOKENS=800
GROQ_SMALL_OTPM_LIMIT=1000
# Groq per-request TPM (input + max_tokens reservation). max_tokens is shrunk to fit.
GROQ_STRONG_TPM_LIMIT=8000
GROQ_SMALL_TPM_LIMIT=6000
# Chars of target-file text in the Code Agent prompt. 0 = derive from
# GROQ_STRONG_TPM_LIMIT (so the prompt fits Groq); raise only if you upgrade the tier.
CODE_AGENT_CONTEXT_CHARS=0
CODE_AGENT_REPAIR_ROUNDS=1

# ── Qdrant (container Phase 1, used Phase 2) ──────────────────────
QDRANT_HOST=localhost
QDRANT_PORT=6333
QDRANT_COLLECTION_CODE=code_chunks
QDRANT_COLLECTION_PAGES=page_content
QDRANT_COLLECTION_KNOWLEDGE=optimization_knowledge

# ── Neo4j (container Phase 1, used Phase 2) ───────────────────────
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=

# ── Local models (Phase 2 / Phase 5) ──────────────────────────────
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
EMBEDDING_DIM=384
RERANKER_MODEL=BAAI/bge-reranker-base
MODEL_IDLE_UNLOAD_SECONDS=600
# Audit-time retrieval (embed + Qdrant + Neo4j + rerank per fired rule). Slow;
# adds derived evidence rows only. Scores and findings are identical without it.
AUDIT_RETRIEVAL_ENABLED=false

# ── Workspaces (Phase 2) ──────────────────────────────────────────
WORKSPACE_ROOT=./workspaces
# Max seconds for one git command (clone/push). Raise for very large repos.
GIT_TIMEOUT_SECONDS=900

# ── Crawling (Phase 3) ────────────────────────────────────────────
CRAWL_USER_AGENT=ArchitectOSBot/1.0
CRAWL_MAX_URLS=200
CRAWL_MAX_DEPTH=4
CRAWL_FETCH_TIMEOUT_SECONDS=20
CRAWL_MAX_HTML_BYTES=1572864
PLAYWRIGHT_MAX_CONTEXTS=2
PLAYWRIGHT_TIMEOUT_SECONDS=25
LIGHTHOUSE_ENABLED=true

# ── GitHub (Phase 9) ──────────────────────────────────────────────
# OAuth 2.0 is primary (same shape as Search Console). Create an OAuth App
# under GitHub → Settings → Developer settings → OAuth Apps. Callback URL
# must match GITHUB_OAUTH_REDIRECT_URI exactly.
# Scopes requested: repo read:user (clone, push, PRs, list accessible repos).
# Tokens are stored encrypted on platform_connections. Never logged, never sent to an LLM.
# GITHUB_TOKEN is unused at runtime. A PAT can still be pasted as a fallback in the UI.
GITHUB_TOKEN=
GITHUB_API_BASE_URL=https://api.github.com
GITHUB_OAUTH_CLIENT_ID=
GITHUB_OAUTH_CLIENT_SECRET=
GITHUB_OAUTH_REDIRECT_URI=http://localhost:6001/api/v1/github/oauth/callback

# ── Google Search Console (Phase 11) — OAuth 2.0 Web client ───────
# Create an OAuth client (Web application) in Google Cloud Console.
# Enable Search Console API. Add the redirect URI below to the client.
# Do not use a service-account JSON key.
GSC_OAUTH_CLIENT_ID=
GSC_OAUTH_CLIENT_SECRET=
GSC_OAUTH_REDIRECT_URI=http://localhost:6001/api/v1/search-console/oauth/callback

# ── Sandbox (Phase 7) ─────────────────────────────────────────────
SANDBOX_IMAGE=
SANDBOX_CPU_LIMIT=2
SANDBOX_MEMORY_LIMIT=2g
SANDBOX_TIMEOUT_SECONDS=600
SANDBOX_RUN_AS_UID=
SANDBOX_PREVIEW_PORT=3000
SANDBOX_PREVIEW_READY_SECONDS=90

# ── Scope envelope + targeted validation (Phase 7) ────────────────
SCOPE_MAX_FILES_CHANGED=10
SCOPE_MAX_LINES_CHANGED=200
SCOPE_MAX_DIFF_BYTES=20000
SCOPE_FORBIDDEN_DIRECTORIES=auth,database,migrations,alembic,.git,node_modules,secrets,.env
TARGETED_VALIDATION_MAX_URLS=5
TARGETED_VALIDATION_SIBLING_URLS=5

# ── Resource manager (Phase 13, hooks from Phase 1) ───────────────
MAX_CONCURRENT_HEAVY_JOBS=1
RAM_PRESSURE_THRESHOLD_MB=2048

# ── SMTP (site health report email) ───────────────────────────────
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
SITE_REPORT_EMAIL_TO=
SITE_REPORT_SCHEDULE_PATH=site_report_schedule.yaml